classDiagram
    direction LR
    class Category {
        <<enumeration>>
        CONTACT
        IDENTITY
        EXPERIENCE
        EDUCATION
        PROGRAMMING_LANGUAGE
        FRAMEWORK_LIBRARY
        DATABASE
        TOOL_TECHNOLOGY
        OTHER
    }
    class Scope {
        <<enumeration>>
        DOCUMENT
        SKILLS_SECTION
    }
    class RegexSpec {
        <<frozen dataclass>>
        +str name
        +Category category
        +str pattern
        +str description
        +tuple accepts
        +tuple rejects
        +int flags
        +int group
        +Scope scope
        +tuple techniques
        +str rationale
        +regex() Pattern
        +recognises(text) bool
        +example_failures() list
    }
    class ExtractedItem {
        <<frozen dataclass>>
        +str spec_name
        +Category category
        +str text
        +int start
        +int end
        +to_dict() dict
        +from_dict(data) ExtractedItem
    }
    class ExtractionResult {
        <<dataclass>>
        +list raw_tokens
        +int years_of_experience
        +str candidate_name
        +list items
        +contact dict
        +education list
        +job_titles list
        +to_dict() dict
        +from_dict(data) ExtractionResult
    }
    class ResumeExtractor {
        +tuple specs
        +extract(cv_text) ExtractionResult
        -_run_specs(text, skills_spans) list
        -_resolve_overlaps(items) list
        -_unknown_skills(text, spans, items) list
        -_raw_tokens(items) list
        -_years(items) int
    }
    class Section {
        <<frozen dataclass>>
        +str name
        +int start
        +int end
        +body(text) str
    }
    RegexSpec --> Category
    RegexSpec --> Scope
    ExtractedItem --> Category
    ExtractionResult "1" o-- "*" ExtractedItem
    ResumeExtractor "1" o-- "19" RegexSpec : runs
    ResumeExtractor ..> ExtractionResult : builds
    ResumeExtractor ..> Section : uses